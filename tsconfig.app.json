{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "env.d.ts",
    "src/main.tsx",
    "src/App.tsx",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/pages/**/*.tsx",
    "src/i18n/**/*.json",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/config/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
