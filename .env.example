FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
APP_BIND_IP=127.0.0.1
APP_PORT=8080
POSTGRES_DB=game_hall
POSTGRES_USER=game_hall
POSTGRES_PASSWORD=change_me_game_hall_postgres
POSTGRES_HOST_PORT=15432
# Separate long random secret used to sign ordinary user sessions.
USER_SESSION_SECRET=change_me_to_a_long_random_user_session_secret
DATABASE_INIT_RETRY_ATTEMPTS=10
DATABASE_INIT_RETRY_DELAY_MS=1000
# Runtime query and pool guards. Migrations disable statement/lock timeouts
# inside their own transaction so large index builds can finish safely.
POSTGRES_POOL_MAX=10
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LOCK_TIMEOUT_MS=10000
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
POSTGRES_APPLICATION_NAME=trovebbs-backend
# Ordinary JSON requests are intentionally small. Leaderboard collection has a
# separate byte limit because one real board currently reaches about 19 MB.
JSON_BODY_LIMIT=256kb
URLENCODED_BODY_LIMIT=64kb
LEADERBOARD_COLLECTOR_BODY_LIMIT=32mb
# Required to enable leaderboard collection. Use at least 32 random characters;
# an empty or short value leaves collector routes fail-closed with HTTP 503.
LEADERBOARD_COLLECTOR_TOKEN=
DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security
NPM_REGISTRY=https://registry.npmmirror.com

# Optional initial admin account. ADMIN_PASSWORD must be set to create/update it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# TrovePal public announcements. Create an application-bound key and bind it to
# the same name configured below. The key is used only by the backend.
TROVEPAL_ENABLED=false
TROVEPAL_API_KEY=
TROVEPAL_APP_NAME=TroveBBS
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# QQ OAuth login. Fill APPID and APPKEY from https://your-oauth-provider.example/.
PUBLIC_BASE_URL=https://example.com
FRONTEND_BASE_URL=https://example.com
QQ_OAUTH_API_URL=https://your-oauth-provider.example/
QQ_OAUTH_APPID=
QQ_OAUTH_APPKEY=
QQ_OAUTH_CALLBACK_URL=https://example.com/api/auth/qq/callback
QQ_OAUTH_FRONTEND_SUCCESS_PATH=/

# Image host. These can also be set and rotated in the administrator console.
IMAGE_HOST_BASE_URL=
IMAGE_HOST_API_KEY=
IMAGE_HOST_REVIEW_FOLDER_ID=
IMAGE_HOST_REQUEST_TIMEOUT_MS=10000
IMAGE_HOST_UPLOAD_TIMEOUT_MS=45000
IMAGE_UPLOAD_MAX_CONCURRENCY=2
TROVEPAL_REQUEST_TIMEOUT_MS=10000

# QQ Bot API v2 team notifications. These seed the first app_settings value;
# later edits in the admin Integrations page take precedence. Keep the secret out of Git.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_TEAM_URL=https://example.com/lobby
QQ_BOT_NOTIFICATION_POLL_MS=15000
