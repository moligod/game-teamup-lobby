{
  "name": "trovebbs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "run-p dev:backend dev:frontend",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix server run dev",
    "build": "run-p type-check \"build-only {@}\" -- && npm run check:bundle",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.8.0",
    "vite": "^7.0.6"
  }
}
